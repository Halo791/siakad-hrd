<script>
function cardsCenter()
{
   /*  testimonial one function by = owl.carousel.js */ 
   jQuery('.card-slider').owlCarousel({
      loop:true,
      margin:0,
      nav:true,
      center:true,
      animateOut: 'fadeOut',
      animateIn: 'fadeIn',
      slideSpeed: 3000,
      paginationSpeed: 3000,
      dots: false,
      navText: ['', ''],
      speed:1000,
      
      autoplay: {
         delay: 1000,
      },
      responsive:{
         0:{
            items:1
         },
         576:{
            items:1
         },	
         800:{
            items:2
         },			
         991:{
            items:2
         },
         1200:{
            items:2
         },
         1600:{
            items:3
         }
      }
   })
}

jQuery(window).on('load',function(){
   setTimeout(function(){
      cardsCenter();
   }, 1000); 
});
</script>